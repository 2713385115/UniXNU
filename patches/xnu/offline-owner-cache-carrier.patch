@@ -2225,6 +2225,132 @@ static void shared_region_map_and_slide_cleanup(
 	struct _sr_file_mappings *sr_file_mappings,
 	struct vm_shared_region  *shared_region);
 
+#if defined(XNU_OWNER_CACHE_CARRIER) && XNU_OWNER_CACHE_CARRIER && !CONFIG_CSR
+#if !DEVELOPMENT && !DEBUG
+#error The independent owner cache carrier is a development instrument
+#endif
+extern int native_verified_block_root_authorized(dev_t);
+extern int native_verified_block_volume_device(const char *, dev_t *, char *, size_t);
+unsigned long native_owner_cache_carrier_accepts = 0;
+unsigned long native_owner_cache_carrier_rejects = 0;
+volatile dev_t native_owner_cache_carrier_root_device = NODEV;
+volatile dev_t native_owner_cache_carrier_file_device = NODEV;
+
+static boolean_t
+native_owner_shared_cache_carrier(vnode_t process_root, vnode_t file)
+{
+	const char *root_uuid = "04769D26-2CA0-4825-B443-E2E5F88300F2";
+#if defined(XNU_OWNER_CACHE_CARRIER_WRONG_UUID) && XNU_OWNER_CACHE_CARRIER_WRONG_UUID
+	const char *cache_uuid = "9846FE78-2910-4297-AF97-D59BB6F8FC16";
+#else
+	const char *cache_uuid = "8846FE78-2910-4297-AF97-D59BB6F8FC16";
+#endif
+	/* The cache directory may sit at the cryptex mount point used by this
+	 * image: /private/preboot/Cryptexes/OS on stock layouts, or the root of
+	 * the mounted SystemOS volume when it is mounted directly at
+	 * /private/preboot.  Accept whichever one really exists. */
+	const char *directories[] = {
+		"/private/preboot/Cryptexes/OS/System/Library/Caches/com.apple.dyld",
+		"/private/preboot/System/Library/Caches/com.apple.dyld",
+		"/System/Cryptexes/OS/System/Library/Caches/com.apple.dyld",
+	};
+	vnode_t expected_parent = NULLVP, device_vnode;
+	dev_t root_device = NODEV, cache_device = NODEV, expected = NODEV;
+	char device_path[64];
+	boolean_t authorized = FALSE, dir_found = FALSE;
+	mount_t root_mount, cache_mount;
+	int why = 0, di = -1, i;
+
+	if (process_root != rootvnode) {
+		why = 1;
+		goto out;
+	}
+	if (!file || vnode_vtype(file) != VREG) {
+		why = 2;
+		goto out;
+	}
+	root_mount = vnode_mount(process_root);
+	cache_mount = vnode_mount(file);
+	if (!root_mount || !cache_mount || root_mount == cache_mount) {
+		why = 3;
+		goto out;
+	}
+	if (!(vfs_flags(root_mount) & MNT_RDONLY) || !(vfs_flags(cache_mount) & MNT_RDONLY)) {
+		why = 4;
+		goto out;
+	}
+	if (strcmp(vfs_statfs(root_mount)->f_fstypename, "apfs") ||
+	    strcmp(vfs_statfs(cache_mount)->f_fstypename, "apfs")) {
+		why = 5;
+		goto out;
+	}
+	device_vnode = vfs_devvp(root_mount);
+	if (device_vnode) {
+		root_device = vnode_specrdev(device_vnode);
+		vnode_put(device_vnode);
+	}
+	device_vnode = vfs_devvp(cache_mount);
+	if (device_vnode) {
+		cache_device = vnode_specrdev(device_vnode);
+		vnode_put(device_vnode);
+	}
+	if (root_device == NODEV || cache_device == NODEV) {
+		why = 6;
+		goto out;
+	}
+	if (!native_verified_block_volume_device(root_uuid, &expected, device_path, sizeof(device_path))) {
+		why = 7;
+		goto out;
+	}
+	if (expected != root_device) {
+		why = 8;
+		goto out;
+	}
+	if (!native_verified_block_volume_device(cache_uuid, &expected, device_path, sizeof(device_path))) {
+		why = 9;
+		goto out;
+	}
+	if (expected != cache_device) {
+		why = 10;
+		goto out;
+	}
+	for (i = 0; i < (int)(sizeof(directories) / sizeof(directories[0])); i++) {
+		if (vnode_lookup(directories[i], 0, &expected_parent,
+		    vfs_context_current()) == 0) {
+			dir_found = TRUE;
+			di = i;
+			break;
+		}
+		expected_parent = NULLVP;
+	}
+	if (!dir_found) {
+		why = 11;
+		goto out;
+	}
+	if (vnode_vtype(expected_parent) != VDIR) {
+		why = 12;
+	} else if (vnode_mount(expected_parent) != cache_mount) {
+		why = 13;
+	} else if (vnode_parent(file) != expected_parent) {
+		why = 14;
+	} else if (!native_verified_block_root_authorized(root_device)) {
+		why = 15;
+	} else {
+		authorized = TRUE;
+	}
+out:
+	if (expected_parent) vnode_put(expected_parent);
+	native_owner_cache_carrier_root_device = root_device;
+	native_owner_cache_carrier_file_device = cache_device;
+	if (authorized) os_atomic_inc(&native_owner_cache_carrier_accepts, relaxed);
+	else os_atomic_inc(&native_owner_cache_carrier_rejects, relaxed);
+	printf("SRT: carrier why=%d dir=%d rootdev=0x%x cachedv=0x%x acc=%lu rej=%lu\n",
+	    why, di, (unsigned int)root_device, (unsigned int)cache_device,
+	    native_owner_cache_carrier_accepts, native_owner_cache_carrier_rejects);
+	return authorized;
+}
+#endif
+
 /*
  * Setup part of _shared_region_map_and_slide().
  * It had to be broken out of _shared_region_map_and_slide() to
@@ -2259,6 +2385,8 @@ shared_region_map_and_slide_setup(
 		(void *)VM_KERNEL_ADDRPERM(current_thread()),
 		proc_getpid(p), p->p_comm));
 
