 	if (files_count > _SR_FILE_MAPPINGS_MAX_FILES) {
 		error = E2BIG;
 		goto done;
@@ -2290,6 +2418,8 @@ shared_region_map_and_slide_setup(
 	/* get the process's shared region (setup in vm_map_exec()) */
 	shared_region = vm_shared_region_trim_and_get(current_task());
 	*shared_region_ptr = shared_region;
+	printf("SRT: sr=%d rdir_is_root=%d\n", shared_region != NULL,
+	    rdir_vp == rootvnode);
 	if (shared_region == NULL) {
 		SHARED_REGION_TRACE_ERROR(
 			("shared_region: %p [%d(%s)] map(): "
@@ -2417,6 +2547,7 @@ shared_region_map_and_slide_setup(
 		 *       of the shared cache */
 		error = mac_file_check_mmap(vfs_context_ucred(vfs_context_current()),
 		    srfmp->fp->fp_glob, VM_PROT_ALL, MAP_FILE | MAP_PRIVATE | MAP_FIXED, 0, &maxprot);
+		printf("SRT: macf err=%d\n", error);
 		if (error) {
 			goto done;
 		}
@@ -2499,6 +2630,7 @@ root_check:
 				error));
 			goto done;
 		}
+		printf("SRT: uid=%d\n", (int)va.va_uid);
 		if (va.va_uid != 0) {
 			SHARED_REGION_TRACE_ERROR(
 				("shared_region: %p [%d(%s)] map(%p:'%s'): "
@@ -2557,7 +2689,18 @@ after_root_check:
 		 * is either on the root volume or in the preboot cryptex volume.
 		 */
 		assert(rdir_vp != NULL);
+#if defined(XNU_OWNER_CACHE_CARRIER) && XNU_OWNER_CACHE_CARRIER
+		boolean_t owner_carrier = FALSE;
+#endif
+		printf("SRT: mountcmp same=%d rootro=%d cachero=%d name=%.40s\n",
+		    srfmp->vp->v_mount == rdir_vp->v_mount,
+		    (vfs_flags(rdir_vp->v_mount) & MNT_RDONLY) != 0,
+		    (vfs_flags(srfmp->vp->v_mount) & MNT_RDONLY) != 0,
+		    srfmp->vp->v_name);
 		if (srfmp->vp->v_mount != rdir_vp->v_mount) {
+#if defined(XNU_OWNER_CACHE_CARRIER) && XNU_OWNER_CACHE_CARRIER
+			owner_carrier = native_owner_shared_cache_carrier(rdir_vp, srfmp->vp);
+#endif
 			vnode_t preboot_vp = NULL;
 #if XNU_TARGET_OS_OSX
 #define PREBOOT_CRYPTEX_PATH "/System/Volumes/Preboot/Cryptexes"
@@ -2565,7 +2708,11 @@ after_root_check:
 #define PREBOOT_CRYPTEX_PATH "/private/preboot/Cryptexes"
 #endif
 			error = vnode_lookup(PREBOOT_CRYPTEX_PATH, 0, &preboot_vp, vfs_context_current());
-			if (error || srfmp->vp->v_mount != preboot_vp->v_mount) {
+			if ((error || srfmp->vp->v_mount != preboot_vp->v_mount)
+#if defined(XNU_OWNER_CACHE_CARRIER) && XNU_OWNER_CACHE_CARRIER
+			    && !owner_carrier
+#endif
+			    ) {
 				SHARED_REGION_TRACE_ERROR(
 					("shared_region: %p [%d(%s)] map(%p:'%s'): "
 					"not on process' root volume nor preboot volume\n",
@@ -2584,7 +2731,12 @@ after_root_check:
 		}
 #endif /* CONFIG_CSR */
 
-		if (scdir_enforce) {
+		printf("SRT: scdir_enforce=%d\n", scdir_enforce);
+		if (scdir_enforce
+#if defined(XNU_OWNER_CACHE_CARRIER) && XNU_OWNER_CACHE_CARRIER && !CONFIG_CSR
+		    && !owner_carrier
+#endif
+		    ) {
 			char **expected_scdir_path = is_driverkit ? driverkit_scdir_path : scdir_path;
 			struct vnode *scdir_vp = NULL;
 			for (expected_scdir_path = is_driverkit ? driverkit_scdir_path : scdir_path;
@@ -2689,6 +2841,7 @@ scdir_ok:
 		}
 	}
 done:
+	printf("SRT: setup done err=%d\n", error);
 	if (error != 0) {
 		shared_region_map_and_slide_cleanup(p, files_count, *sr_file_mappings, shared_region);
 		*sr_file_mappings = NULL;
@@ -2740,6 +2893,7 @@ _shared_region_map_and_slide(
 	error = shared_region_map_and_slide_setup(p, files_count,
 	    files, mappings_count, mappings,
